# --- Photon / iMessage (app.photon.codes) --- [primary adapter: pnpm start]
# Create a project in the Photon dashboard and copy its credentials.
# Free tier: up to 10 users, no per-message cost.
PROJECT_ID=
PROJECT_SECRET=
# Optional: pin the group-chat feed. If unset, the first iMessage group the
# agent hears becomes the feed automatically (add the agent's number to your
# friend-group thread).
HOME_SPACE_ID=

# --- Discord (discord.com/developers/applications) --- [alt: pnpm start:discord]
# Create an application -> Bot -> copy token. Enable the MESSAGE CONTENT
# privileged intent (needed for the DM chat flow). Invite the bot to your
# server with the bot scope + Send Messages permission.
DISCORD_TOKEN=
DISCORD_APP_ID=
# Right-click your server -> Copy Server ID (enable Developer Mode in settings)
GUILD_ID=
# The channel where the public bet feed gets posted
CHANNEL_ID=

# --- Keys ---
# Derives every user's signing key. Treat like a master password: anyone who
# has it controls every account. Back it up — it IS the ledger custody.
MASTER_SEED=

# Pays gas top-ups for user accounts. On Base Sepolia: any faucet-funded key.
# Defaults to anvil account #0 for local dev.
FUNDER_KEY=

# --- Chain (defaults: local anvil) ---
# For Base Sepolia: CHAIN_ID=84532, RPC_URL=https://sepolia.base.org,
# CONTRACT_ADDRESS from `pnpm --filter bot deploy`.
CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8545
CONTRACT_ADDRESS=
