# Leave everything unset for local dev (anvil + persona switcher).
# Set all of these for the Base Sepolia deployment:

# Privy app id (dashboard.privy.io) — enables email/Google login.
# Also enable Smart Wallets (Kernel) + your paymaster URL in the Privy dashboard,
# and add your GitHub Pages origin under Allowed Origins.
VITE_PRIVY_APP_ID=

# 84532 = Base Sepolia, 31337 = anvil (default)
VITE_CHAIN_ID=84532
VITE_RPC_URL=https://sepolia.base.org

# From the Deploy.s.sol broadcast output
VITE_CONTRACT_ADDRESS=
VITE_DEPLOY_BLOCK=
